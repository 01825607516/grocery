# Website -> Dokani backend. These are read on the SERVER only (no NEXT_PUBLIC_ prefix), so they are never sent to the browser.
DOKANI_BASE_URL=https://app.dokani.cloud/api
DOKANI_LOGIN=
DOKANI_PASSWORD=
DOKANI_SHOP_ID=
DOKANI_BRANCH_ID=
# Needed for bKash / Nagad / Card orders. Without it only Cash on Delivery is offered at checkout.
DOKANI_BANK_ID=
DOKANI_SOURCE=freshly
# Browser -> this website's own server route that forwards shopper calls to Dokani.
NEXT_PUBLIC_AUTH_API=/api/shop
